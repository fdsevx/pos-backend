# Salin file ini menjadi .env (JANGAN di-commit).
# URI diambil dari Aiven Console > service PostgreSQL > Service URI (pakai sslmode=require).

# Dipakai drizzle-kit (migrasi) dan seed dari komputer lokal
DATABASE_URL=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Dipakai wrangler dev (koneksi lokal ke database untuk binding HYPERDRIVE)
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
